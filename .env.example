# Resend API key with permission to send from the verified domain
RESEND_API_KEY=re_your_api_key_here
# Verified sender, for example: Kitchen Solutions <no-reply@kitchensolution.cl>
LEADS_FROM_EMAIL=Kitchen Solutions <contacto@kitchensolution.cl>
# Used to load the logo in email clients
NEXT_PUBLIC_SITE_URL=https://kitchensolution.cl
